{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.config.ts",
    "**/*.config.js",
    "**/*.config.cjs",
    "vite.config.ts",
    "postcss.config.cjs",
    "tailwind.config.cjs"
  ]
}

